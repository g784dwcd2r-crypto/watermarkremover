# ---------------------------------------------------------------------------
# ArtRestore Studio - example environment configuration
# Copy to .env and adjust. Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
ARS_ENVIRONMENT=development            # development | staging | production
ARS_DEBUG=true
ARS_APP_NAME="ArtRestore Studio"
ARS_PUBLIC_WEB_URL=http://localhost:3000
ARS_PUBLIC_API_URL=http://localhost:8000

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
ARS_SECRET_KEY=dev-only-insecure-secret-key-change-me-please-0123456789
ARS_SESSION_COOKIE_NAME=ars_session
ARS_CSRF_COOKIE_NAME=ars_csrf
ARS_SESSION_TTL_SECONDS=1209600        # 14 days
ARS_COOKIE_SECURE=false                # MUST be true in production (HTTPS only)
ARS_COOKIE_DOMAIN=
ARS_COOKIE_SAMESITE=lax
ARS_CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
ARS_DATABASE_URL=postgresql+psycopg://artrestore:artrestore@localhost:5432/artrestore

# --- Redis / Celery --------------------------------------------------------
ARS_REDIS_URL=redis://localhost:6379/0
ARS_CELERY_BROKER_URL=redis://localhost:6379/1
ARS_CELERY_RESULT_BACKEND=redis://localhost:6379/2
ARS_CELERY_TASK_ALWAYS_EAGER=false     # true runs jobs inline (tests / no worker)

# --- Object storage --------------------------------------------------------
# ARS_STORAGE_BACKEND=s3 | local
ARS_STORAGE_BACKEND=s3
ARS_S3_ENDPOINT_URL=http://localhost:9000
ARS_S3_REGION=us-east-1
ARS_S3_BUCKET=artrestore
ARS_S3_ACCESS_KEY_ID=minioadmin
ARS_S3_SECRET_ACCESS_KEY=minioadmin
ARS_S3_USE_PATH_STYLE=true
ARS_SIGNED_URL_TTL_SECONDS=300         # short-lived signed URLs (5 minutes)
# Only used when ARS_STORAGE_BACKEND=local
ARS_LOCAL_STORAGE_DIR=./storage-data

# --- Uploads / limits ------------------------------------------------------
ARS_MAX_UPLOAD_BYTES=41943040          # 40 MiB
ARS_MAX_IMAGE_PIXELS=50000000          # decompression-bomb guard
ARS_ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp,image/tiff
ARS_MAX_AUDIO_BYTES=20971520           # 20 MiB (optional timelapse music)
ARS_ALLOWED_AUDIO_MIME=audio/mpeg,audio/wav,audio/ogg

# --- Retention / privacy ---------------------------------------------------
ARS_DEFAULT_RETENTION_DAYS=7           # allowed: 1 | 7 | 30
ARS_RETENTION_SWEEP_MINUTES=60
ARS_LOG_LEVEL=INFO
# Image bytes and signed URLs are never logged; see docs/policies/privacy-policy.md

# --- Rate limiting ---------------------------------------------------------
ARS_RATE_LIMIT_ENABLED=true
ARS_RATE_LIMIT_AUTH_PER_MINUTE=10
ARS_RATE_LIMIT_UPLOAD_PER_MINUTE=30
ARS_RATE_LIMIT_JOB_PER_MINUTE=30
ARS_RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- Image processing ------------------------------------------------------
ARS_INPAINT_BACKEND=auto               # auto | opencv | lama | diffusion
ARS_LAMA_MODEL_PATH=                   # path to a locally deployed LaMa checkpoint (optional)
ARS_DIFFUSION_MODEL_PATH=              # optional diffusion inpainting adapter
ARS_SEGMENTATION_MODEL_PATH=           # optional assisted-selection segmentation model
ARS_PROTECTED_REGION_ENFORCEMENT=block # block | warn (block is the shipped default)

# --- Video rendering -------------------------------------------------------
ARS_FFMPEG_BINARY=ffmpeg
ARS_FFPROBE_BINARY=ffprobe
ARS_PREVIEW_MAX_DIMENSION=640
ARS_MAX_RENDER_SECONDS=300             # 5 minute maximum timelapse duration

# --- Policy versions (recorded in ConsentRecord) ---------------------------
ARS_AUTHORIZED_USE_POLICY_VERSION=2026-01-15
ARS_PRIVACY_POLICY_VERSION=2026-01-15
ARS_TERMS_VERSION=2026-01-15

# --- Observability ---------------------------------------------------------
# Placeholder for an error-tracking provider (Sentry-compatible DSN).
ARS_ERROR_TRACKING_DSN=
ARS_ERROR_TRACKING_SAMPLE_RATE=0.1

# --- Frontend (Next.js) ----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="ArtRestore Studio"
NEXT_PUBLIC_MAX_UPLOAD_BYTES=41943040

# --- Transactional email ----------------------------------------------------
# Unset host = development mode: reset/sign-in links are logged (redacted) and
# returned through the API. Set a host to send real mail over SMTP + STARTTLS.
ARS_SMTP_HOST=
ARS_SMTP_PORT=587
ARS_SMTP_USERNAME=
ARS_SMTP_PASSWORD=
ARS_SMTP_FROM=
ARS_SMTP_STARTTLS=true

# --- Abuse limits -----------------------------------------------------------
ARS_MAX_USER_STORAGE_BYTES=2147483648   # 2 GiB per account
ARS_MAX_ACTIVE_JOBS_PER_USER=5          # queued + running, across projects
ARS_TASK_TIME_LIMIT_SECONDS=3600        # hard worker-task wall clock
